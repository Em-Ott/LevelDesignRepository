    Clip: {fileID: 8300000, guid: 75422903e7630064e9a19bdf2eb72616, type: 3}
    Channel: 2
    Emitter: {fileID: 3689503627835179758}
    Volume: 1
    Speaker: 2
    Subtitle: "No need to run\u2026"
  - Name: Banging On Doors
    Time: 73
    Clip: {fileID: 8300000, guid: bf1213ab4a997a44287e3cd500f17ec5, type: 3}
    Channel: 1
    Emitter: {fileID: 8216980626228494347}
    Volume: 1
    Speaker: 0
    Subtitle: 
