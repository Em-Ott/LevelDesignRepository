    Clip: {fileID: 8300000, guid: 0b616dfb2d6026a4da22a19c77fb49f7, type: 3}
    Channel: 2
    Emitter: {fileID: 8708767625550828086}
    Volume: 1
    Speaker: 1
    Subtitle: "I don't see anyone anymore\u2026 am I safe now?"
  - Name: Killer Footsteps Approach
    Time: 44
    Clip: {fileID: 8300000, guid: c8d17159ab343ce4a83e2091922997fa, type: 3}
    Channel: 1
    Emitter: {fileID: 3689503627835179758}
    Volume: 1
    Speaker: 0
    Subtitle: 
  - Name: V03_AreThoseFootsteps
    Time: 47.2
    Clip: {fileID: 8300000, guid: b14bf5d979b11e245ba49bc8d8680705, type: 3}
    Channel: 2
    Emitter: {fileID: 8708767625550828086}
    Volume: 1
    Speaker: 1
    Subtitle: "Are those\u2026 footsteps?"
  - Name: K04_ComeBackHere
    Time: 52
    Clip: {fileID: 8300000, guid: 97e9a19c973c4fb4f979c42626bc4bda, type: 3}
    Channel: 2
    Emitter: {fileID: 3689503627835179758}
    Volume: 1
    Speaker: 2
    Subtitle: "Come back heeeeere\u2026"
  - Name: V05_NoNoNo
    Time: 55.5
    Clip: {fileID: 8300000, guid: 9719ecc44d48bc34da8d8b3fce225109, type: 3}
    Channel: 2
    Emitter: {fileID: 8708767625550828086}
    Volume: 1
    Speaker: 1
    Subtitle: No, no, no, it can't be!
  - Name: Victim Runs To Elevator
    Time: 58
    Clip: {fileID: 8300000, guid: e6f321140b45ddd40a08bd48fa8f7943, type: 3}
    Channel: 1
    Emitter: {fileID: 8708767625550828086}
    Volume: 1
    Speaker: 0
    Subtitle: 
  - Name: V06_TheElevator
    Time: 62.25
    Clip: {fileID: 8300000, guid: d7a7512f990aca84ab9d1c312cccba4d, type: 3}
    Channel: 2
    Emitter: {fileID: 8708767625550828086}
    Volume: 1
    Speaker: 1
    Subtitle: "The elevator! I can get out! What the\u2014 why aren't the buttons
      working?"
  - Name: Call Buttons
    Time: 64.1
    Clip: {fileID: 8300000, guid: 6017dbeb1f932c14a920170136ffe333, type: 3}
