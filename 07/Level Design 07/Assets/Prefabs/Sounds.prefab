    Time: 73.7
    Clip: {fileID: 8300000, guid: a8b497a1a781e524ba80debc1bf72d32, type: 3}
    Channel: 2
    Emitter: {fileID: 8708767625550828086}
    Volume: 1
    Speaker: 1
    Subtitle: Help! Help me! Can anyone hear me?
  - Name: K09_ItsForYourOwnGood
    Time: 81
    Clip: {fileID: 8300000, guid: aff8e869e3ab171438b508a06a695d70, type: 3}
    Channel: 2
    Emitter: {fileID: 3689503627835179758}
    Volume: 1
    Speaker: 2
    Subtitle: It's for your own good.
  - Name: V10_ItCantBe
    Time: 85
    Clip: {fileID: 8300000, guid: e9a23fa3c94b0924c812479ab27c4f54, type: 3}
    Channel: 2
    Emitter: {fileID: 8708767625550828086}
    Volume: 1
    Speaker: 1
    Subtitle: Ah! No! It can't be!
  - Name: Victim Crying
    Time: 87.6
    Clip: {fileID: 8300000, guid: ab0cb831b3e9f184e817c961b75461e1, type: 3}
    Channel: 1
    Emitter: {fileID: 8708767625550828086}
    Volume: 1
    Speaker: 0
    Subtitle: 
  - Name: K10_NoOneIsComing
    Time: 89
    Clip: {fileID: 8300000, guid: 17560fae5a6f8024fac23fbd3221e491, type: 3}
    Channel: 2
    Emitter: {fileID: 3689503627835179758}
    Volume: 1
    Speaker: 2
    Subtitle: No one is coming to help you.
  - Name: V11_StayAway
    Time: 93.5
    Clip: {fileID: 8300000, guid: 5e0e0ba9669d37a419f3479090e7f2bb, type: 3}
    Channel: 2
    Emitter: {fileID: 8708767625550828086}
    Volume: 1
    Speaker: 1
    Subtitle: No! Stay away! I haven't done anything!
